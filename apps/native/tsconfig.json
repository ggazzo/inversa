{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": [
        "App.tsx",
        "tamagui.config.ts",
        "src/**/*.ts",
        "src/**/*.tsx"
    ]
}
