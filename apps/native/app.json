{
  "expo": {
    "name": "BrewPilot",
    "slug": "brewpilot",
    "owner": "ggazzo",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "brewpilot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brewpilot.controller",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "BrewPilot precisa do Bluetooth para se conectar ao controlador de fermentação.",
        "NSBluetoothPeripheralUsageDescription": "BrewPilot precisa do Bluetooth para se conectar ao controlador de fermentação."
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1d232a"
      },
      "package": "com.brewpilot.controller",
      "permissions": [
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "react-native-ble-plx",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000,
      "url": "https://u.expo.dev/0754be71-5229-4862-8d43-538f33ffe4fd"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "eas": {
        "projectId": "0754be71-5229-4862-8d43-538f33ffe4fd"
      }
    }
  }
}
