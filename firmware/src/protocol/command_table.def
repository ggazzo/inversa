// X-macro command table — single source of truth for BLE command dispatch.
//
//   CMD(REQ_CONST, handlerMethod)
//
// REQ_CONST is a Protocol::REQ_* identifier; handlerMethod is the
// CommandHandler member invoked for it. This file is #included in two places:
//
//   1. CommandHandler::handle()  — expands each CMD into a hash-then-verify
//      switch case. Adding a CMD line with no matching method is a compile
//      error, so the switch can never drift out of sync with this list.
//   2. test_command_table.cpp    — iterates the same list to assert the 67
//      command strings are FNV-1a collision-free (the dispatch correctness
//      precondition).
//
// No include guard on purpose: this is an X-macro fragment, included multiple
// times with different CMD definitions.

CMD(REQ_SET_TEMP,             cmdSetTemp)
CMD(REQ_HEATER_ON,            cmdHeaterOn)
CMD(REQ_HEATER_OFF,           cmdHeaterOff)
CMD(REQ_PUMP_ON,              cmdPumpOn)
CMD(REQ_PUMP_OFF,             cmdPumpOff)
